MAX_MIN_DEGREE=14;

repetitions=50;
% measurement_error_var=0.001;
dims=2;
% radio_range=0.15;
all_num_sensors=[100,300];
num_anchors=4;
anchor_layout_type=0;
% randomization_seed=144;
% minimum_degree=dims+3;
show_plots=0;
radio_ranges=[0.2,0.3,0.4];
selection_seed=0;

plot_no=1;
for num_sensor_idx = 1:length(all_num_sensors)
