    for radio_range_idx = 1:length(radio_ranges)
        radio_range=radio_ranges(radio_range_idx);
        load("RandLayoutHyperparameters/S"+num_sensors+"A"+num_anchors+"RR"+radio_range+"Reps"+repetitions+"MDeg"+MAX_MIN_DEGREE+"DynLayout.mat")
        
        subplot(length(all_num_sensors),length(radio_range),plot_no)
        plot_rmsds(MAX_MIN_DEGREE,rmsds_001,rmsds_01,rmsds_05,"Error not normalized w.r.t range; Radio range: "+radio_range+"Num Sensors: "+num_sensors,num_sensors)
        
        plot_no=plot_no+1
    end
    
end



function plot_rmsds(MAX_MIN_DEGREE,rmsds_001,rmsds_01,rmsds_05,plt_title,num_sensors)
    % figure
    % Confidence intervels of measurement error 0.001
    yconf_001 = [max([rmsds_001(:,3:MAX_MIN_DEGREE),rmsds_001(:,num_sensors)]) min([rmsds_001(:,MAX_MIN_DEGREE:-1:3),rmsds_001(:,num_sensors)])];
    % Confidence intervels of measurement error 0.01
    yconf_01 = [max([rmsds_01(:,3:MAX_MIN_DEGREE),rmsds_01(:,num_sensors)]) min([rmsds_01(:,MAX_MIN_DEGREE:-1:3),rmsds_01(:,num_sensors)])];
    % Confidence intervels of measurement error 0.05
    yconf_05 = [max([rmsds_05(:,3:MAX_MIN_DEGREE),rmsds_05(:,num_sensors)]) min([rmsds_05(:,MAX_MIN_DEGREE:-1:3),rmsds_05(:,num_sensors)])];

    
    x=[3:MAX_MIN_DEGREE,MAX_MIN_DEGREE+1];
    xconf = [x x(end:-1:1)] ;
    
    hold on
    
    fill001 = fill(xconf,yconf_001,'blue');
    fill001.FaceAlpha=0.1;
    fill001.EdgeColor = 'none';  
    fill001.HandleVisibility="off";
    
    fill01 = fill(xconf,yconf_01,'red');
    fill01.FaceAlpha=0.1;
    fill01.EdgeColor = 'none'; 
    fill01.HandleVisibility="off";
    
    fill05 = fill(xconf,yconf_05,'green');
    fill05.FaceAlpha=0.1;
    fill05.EdgeColor = 'none'; 
    fill05.HandleVisibility="off";
    

    
    
    plot(x,mean([rmsds_001(:,3:MAX_MIN_DEGREE),rmsds_001(:,num_sensors)]),'bO--','DisplayName',"0.001");
    plot(x,mean([rmsds_01(:,3:MAX_MIN_DEGREE),rmsds_01(:,num_sensors)]),'rO--','DisplayName',"0.01");
    plot(x,mean([rmsds_05(:,3:MAX_MIN_DEGREE),rmsds_05(:,num_sensors)]),'gO--','DisplayName',"0.05");
 
    title(plt_title);
    legend
    
    hold off
end